# Device Configuration for Infinix Hot 10 (X682C - x682c_h694)
#

DEVICE_PATH := device/infinix/X682C

# Architecture
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_ABI2 :=
TARGET_CPU_VARIANT := generic

TARGET_2ND_ARCH := arm
TARGET_2ND_ARCH_VARIANT := armv8-a
TARGET_2ND_CPU_ABI := armeabi-v7a
TARGET_2ND_CPU_ABI2 := armeabi
TARGET_2ND_CPU_VARIANT := generic
TARGET_SUPPORTS_64_BIT_APPS := true

# Platform & Bootloader (Matched to MT6768_Android_scatter.txt)
TARGET_BOARD_PLATFORM := mt6768
TARGET_NO_BOOTLOADER := true
BOARD_USES_MTK_HARDWARE := true
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true

# Anti-Rollback & Version Spoofing (For Decryption Compatibility)
PLATFORM_SECURITY_PATCH := 2099-12-31
VENDOR_SECURITY_PATCH := 2099-12-31
PLATFORM_VERSION := 16.1.0

# Kernel & Boot Image Headers
BOARD_KERNEL_CMDLINE := bootopt=64S3,32N2,64N2 buildvariant=user androidboot.selinux=permissive
BOARD_KERNEL_BASE := 0x40078000
BOARD_KERNEL_PAGESIZE := 2048
BOARD_KERNEL_OFFSET := 0x00008000
BOARD_RAMDISK_OFFSET := 0x07c08000
BOARD_SECOND_OFFSET := 0x00e88000
BOARD_TAGS_OFFSET := 0x0bc08000
BOARD_DTB_OFFSET := 0x0bc08000
BOARD_BOOT_HEADER_VERSION := 2

# Prebuilt Kernel & DTB
TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilt/Image.gz-dtb
TARGET_PREBUILT_DTB := $(DEVICE_PATH)/prebuilt/dtb.img

BOARD_MKBOOTIMG_ARGS += --kernel_offset $(BOARD_KERNEL_OFFSET)
BOARD_MKBOOTIMG_ARGS += --ramdisk_offset $(BOARD_RAMDISK_OFFSET)
BOARD_MKBOOTIMG_ARGS += --second_offset $(BOARD_SECOND_OFFSET)
BOARD_MKBOOTIMG_ARGS += --tags_offset $(BOARD_TAGS_OFFSET)
BOARD_MKBOOTIMG_ARGS += --dtb_offset $(BOARD_DTB_OFFSET)
BOARD_MKBOOTIMG_ARGS += --dtb $(TARGET_PREBUILT_DTB)
BOARD_MKBOOTIMG_ARGS += --header_version $(BOARD_BOOT_HEADER_VERSION)
BOARD_MKBOOTIMG_ARGS += --os_version 10.0.0
BOARD_MKBOOTIMG_ARGS += --os_patch_level 2022-07

# Exact Partition Sizes from MT6768_Android_scatter.txt
# SYS15 (recovery) = 0x2000000, SYS31 (boot) = 0x2000000, SYS32 (dtbo) = 0x800000, SYS39 (cache) = 0x12c00000
BOARD_BUILD_SYSTEM_ROOT_IMAGE := false
BOARD_HAS_LARGE_FILESYSTEM := true
BOARD_FLASH_BLOCK_SIZE := 131072
BOARD_BOOTIMAGE_PARTITION_SIZE := 33554432
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 33554432
BOARD_DTBOIMG_PARTITION_SIZE := 8388608
BOARD_CACHEIMAGE_PARTITION_SIZE := 314572800
BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4

# Dynamic / Logical Partitions
# SYS38 (super) = 0x15d000000 = 5855248384 bytes
BOARD_SUPER_PARTITION_SIZE := 5855248384
BOARD_SUPER_PARTITION_GROUPS := main
BOARD_MAIN_PARTITION_LIST := system vendor product
BOARD_MAIN_SIZE := 5851054080
BOARD_SUPER_PARTITION_BLOCK_DEVICES := super
BOARD_SUPER_DEVICE_SUPER_DEVICE_SIZE := 5855248384
BOARD_SUPER_PARTITION_METADATA_DEVICE := super

# Recovery FSTAB
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/recovery.fstab

# Ramdisk Compression (Stock kernel only supports GZIP, no LZMA)
BOARD_RAMDISK_USE_LZMA := false
TARGET_STRIP_MODULES := true

# Aggressive OrangeFox Size Optimization (Mandatory to stay < 32MB with GZIP)
FOX_DRASTIC_SIZE_REDUCTION := 1
OFOX_DISABLE_EXTRA_FEATURES := 1
FOX_DISABLE_APP_MANAGER := 1
OFOX_REMOVE_AAPT := 1
FOX_EXCLUDE_AR := 1
FOX_DELETE_AROMA_FM := 1
FOX_DELETE_MAGISK_ADDON := 1
FOX_REMOVE_BASH := 1
FOX_REMOVE_NANO := 1
TW_EXCLUDE_PYTHON := true
TW_EXCLUDE_TWRP_APP := true
TW_EXCLUDE_APEX := true
TW_EXCLUDE_L10N := true
TW_EXTRA_LANGUAGES := false
OF_DONT_KEEP_LOG_HISTORY := 1
OF_NO_SPLASH_CHANGE := 1
OF_QUICK_BACKUP_LIST_ONLY := 1

# Display & UI Setup
TARGET_SCREEN_WIDTH := 720
TARGET_SCREEN_HEIGHT := 1640
TW_THEME := portrait_hdpi
TW_BRIGHTNESS_PATH := "/sys/class/leds/lcd-backlight/brightness"
TW_MAX_BRIGHTNESS := 255
TW_DEFAULT_BRIGHTNESS := 200
TARGET_RECOVERY_PIXEL_FORMAT := "RGBX_8888"
TW_CUSTOM_BATTERY_PATH := "/sys/class/power_supply/battery"
TARGET_RECOVERY_DEFAULT_TIME_ZONE := "Asia/Calcutta"

# OrangeFox Core Config
OF_FLASHLIGHT_ENABLE := 0
OF_SCREEN_H := 1640
OF_STATUS_INDENT_LEFT := 48
OF_STATUS_INDENT_RIGHT := 48
OF_HIDE_NOTCH := 1
OF_USE_GREEN_LED := 0
OF_DONT_PATCH_ENCRYPTED_DEVICE := 1
OF_NO_TREBLE_COMPATIBILITY_CHECK := 1

# Feature Flags
TW_INCLUDE_RESETPROP := true
TW_NO_SECURE_ADBD := true
TW_HAS_MTP := true
TW_EXCLUDE_DEFAULT_USB_INIT := true

# Dynamic Partition Management
TW_INCLUDE_LOGICAL := true
TW_FLASH_LOGICAL := true
OFOX_ALLOW_LOGICAL_PARTITIONS := true
BOARD_SUPPRESS_SECURE_ERASE := true
