# Mountable Logical Partitions (For Mount / Wipe / Backup)
/system         ext4    /dev/block/mapper/system                            flags=display="System";backup=1;wipeingui;logical
/vendor         ext4    /dev/block/mapper/vendor                            flags=display="Vendor";backup=1;wipeingui;logical
/product        ext4    /dev/block/mapper/product                           flags=display="Product";backup=1;wipeingui;logical

# Logical Partition Images (Shown in Flash Image for flashing GSI system.img, vendor.img, product.img)
# Note: Do NOT add /super here; TW_INCLUDE_LOGICAL automatically creates the single Super entry.
/system_image   emmc    /dev/block/mapper/system                            flags=display="System Image";backup=1;flashimg=1;logical
/vendor_image   emmc    /dev/block/mapper/vendor                            flags=display="Vendor Image";backup=1;flashimg=1;logical
/product_image  emmc    /dev/block/mapper/product                           flags=display="Product Image";backup=1;flashimg=1;logical

# Flashable Physical Images (Boot, Recovery, DTBO, VBMeta, Logo)
/boot           emmc    /dev/block/platform/bootdevice/by-name/boot         flags=display="Boot";backup=1;flashimg=1
/recovery       emmc    /dev/block/platform/bootdevice/by-name/recovery     flags=display="Recovery";backup=1;flashimg=1
/dtbo           emmc    /dev/block/platform/bootdevice/by-name/dtbo         flags=display="DTBO";backup=1;flashimg=1
/vbmeta         emmc    /dev/block/platform/bootdevice/by-name/vbmeta       flags=display="VBMeta";backup=1;flashimg=1
/vbmeta_system  emmc    /dev/block/platform/bootdevice/by-name/vbmeta_system flags=display="VBMeta System";backup=1;flashimg=1
/vbmeta_vendor  emmc    /dev/block/platform/bootdevice/by-name/vbmeta_vendor flags=display="VBMeta Vendor";backup=1;flashimg=1
/logo           emmc    /dev/block/platform/bootdevice/by-name/logo         flags=display="Logo";backup=1;flashimg=1

# Standard Data, Metadata & Cache Partitions
/data           f2fs    /dev/block/platform/bootdevice/by-name/userdata     flags=display="Data";backup=1;wipeingui;wipeduringfactoryreset;fileencryption=aes-256-xts:aes-256-cts:v1
/metadata       ext4    /dev/block/platform/bootdevice/by-name/md_udc       flags=display="Metadata";backup=1;wipeingui
/cache          ext4    /dev/block/platform/bootdevice/by-name/cache        flags=display="Cache";backup=1;wipeingui;wipeduringfactoryreset

# MediaTek Protected / IMEI / Calibration Partitions (Backup ONLY - flashimg=0 keeps Flash Image menu clean)
/nvram          emmc    /dev/block/platform/bootdevice/by-name/nvram        flags=display="NVRAM";backup=1;flashimg=0
/nvdata         ext4    /dev/block/platform/bootdevice/by-name/nvdata       flags=display="NVDATA";backup=1;flashimg=0
/nvcfg          ext4    /dev/block/platform/bootdevice/by-name/nvcfg        flags=display="NVCFG";backup=1;flashimg=0
/protect_f      ext4    /dev/block/platform/bootdevice/by-name/protect1     flags=display="Protect_F";backup=1;flashimg=0
/protect_s      ext4    /dev/block/platform/bootdevice/by-name/protect2     flags=display="Protect_S";backup=1;flashimg=0
/persist        ext4    /dev/block/platform/bootdevice/by-name/persist      flags=display="Persist";backup=1;flashimg=0
/proinfo        emmc    /dev/block/platform/bootdevice/by-name/proinfo      flags=display="Proinfo";backup=1;flashimg=0
/seccfg         emmc    /dev/block/platform/bootdevice/by-name/seccfg       flags=display="SecCfg";backup=1;flashimg=0

# Internal Control Partitions (Hidden from Flash Image & Backup UI)
/persistent     emmc    /dev/block/platform/bootdevice/by-name/frp          flags=display="FRP";backup=0;flashimg=0
/para           emmc    /dev/block/platform/bootdevice/by-name/para         flags=display="Para";backup=0;flashimg=0
/misc           emmc    /dev/block/platform/bootdevice/by-name/misc         flags=display="Misc";backup=0;flashimg=0

# Removable Storage
/external_sd    auto    /devices/platform/externdevice*                     flags=display="MicroSD Card";storage;wipeingui;removable
/usb_otg        auto    /devices/platform/mt_usb*                           flags=display="USB-OTG";storage;wipeingui;removable
