# Logical Partitions (Dynamic Partition Images)
/system_image   emmc    /dev/block/platform/bootdevice/by-name/system       flags=display="System Image";backup=1;flashimg=1
/vendor_image   emmc    /dev/block/platform/bootdevice/by-name/vendor       flags=display="Vendor Image";backup=1;flashimg=1
/product_image  emmc    /dev/block/platform/bootdevice/by-name/product      flags=display="Product Image";backup=1;flashimg=1

# Super Partition
/super          emmc    /dev/block/platform/bootdevice/by-name/super        flags=display="Super";backup=1;flashimg=1

# Core Boot / Firmware Partitions
/boot           emmc    /dev/block/platform/bootdevice/by-name/boot         flags=display="Boot";backup=1;flashimg=1
/recovery       emmc    /dev/block/platform/bootdevice/by-name/recovery     flags=display="Recovery";backup=1;flashimg=1
/dtbo           emmc    /dev/block/platform/bootdevice/by-name/dtbo         flags=display="DTBO";backup=1;flashimg=1
/vbmeta         emmc    /dev/block/platform/bootdevice/by-name/vbmeta       flags=display="VBMeta";backup=1;flashimg=1
/vbmeta_system  emmc    /dev/block/platform/bootdevice/by-name/vbmeta_system flags=display="VBMeta System";backup=1;flashimg=1
/vbmeta_vendor  emmc    /dev/block/platform/bootdevice/by-name/vbmeta_vendor flags=display="VBMeta Vendor";backup=1;flashimg=1
/logo           emmc    /dev/block/platform/bootdevice/by-name/logo         flags=display="Logo";backup=1;flashimg=1

# Data, Metadata and Cache
/data           auto    /dev/block/platform/bootdevice/by-name/userdata     flags=display="Data";backup=1;wipeingui;wipeduringfactoryreset
/metadata       ext4    /dev/block/platform/bootdevice/by-name/md_udc       flags=display="Metadata";backup=1;wipeingui
/cache          ext4    /dev/block/platform/bootdevice/by-name/cache        flags=display="Cache";backup=1;wipeingui

# MediaTek NVRAM / Protected Data
/nvram          emmc    /dev/block/platform/bootdevice/by-name/nvram        flags=display="NVRAM";backup=1
/nvdata         ext4    /dev/block/platform/bootdevice/by-name/nvdata       flags=display="NVDATA";backup=1
/nvcfg          ext4    /dev/block/platform/bootdevice/by-name/nvcfg        flags=display="NVCFG";backup=1
/protect_f      ext4    /dev/block/platform/bootdevice/by-name/protect1     flags=display="Protect_F";backup=1
/protect_s      ext4    /dev/block/platform/bootdevice/by-name/protect2     flags=display="Protect_S";backup=1
/persist        ext4    /dev/block/platform/bootdevice/by-name/persist      flags=display="Persist";backup=1
/tranfs         ext4    /dev/block/platform/bootdevice/by-name/tranfs       flags=display="TranFS";backup=1
/tkv            emmc    /dev/block/platform/bootdevice/by-name/tkv          flags=display="TKV";backup=1
/misc           emmc    /dev/block/platform/bootdevice/by-name/misc         flags=display="Misc";backup=1

# External Removable Storage
/external_sd    auto    /devices/platform/externdevice*                     flags=display="MicroSD Card";storage;wipeingui;removable
/usb_otg        auto    /devices/platform/mt_usb*                           flags=display="USB-OTG";storage;wipeingui;removable
