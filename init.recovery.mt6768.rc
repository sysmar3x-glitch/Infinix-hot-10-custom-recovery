on init
    # Start hardware service managers for HALs
    start hwservicemanager
    start vndservicemanager

service hwservicemanager /system/bin/hwservicemanager
    user root
    group root readproc
    onrestart setprop hwservicemanager.ready false
    disabled
    seclabel u:r:recovery:s0

service vndservicemanager /system/bin/vndservicemanager /dev/vndbinder
    disabled
    user root
    group root readproc
    writepid /dev/cpuset/system-background/tasks
    shutdown critical
    seclabel u:r:recovery:s0

# Initialize Keymaster and Gatekeeper for Data Decryption
service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service keymaster-4-0 /vendor/bin/hw/android.hardware.keymaster@4.0-service.beanpod
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0

# Start crypto services once hwservicemanager is ready
on property:hwservicemanager.ready=true
    start keymaster-4-0
    start gatekeeper-1-0

on fs && property:ro.debuggable=0
    # distinguish USB should connect or not, i.e. CDP vs SDP
    write /sys/class/udc/musb-hdrc/device/cmode 2
    # set charging free due to it wait for USB activation
    start adbd

on post-fs
    # Support alias for UFS / eMMC block devices (Removed A/B preloader symlinks)
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
